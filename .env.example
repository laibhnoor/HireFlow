# ---------------------------------------------------------------------------
# Copy this file to .env and fill in real values. Never commit .env.
# ---------------------------------------------------------------------------

# Postgres (docker compose maps container 5432 to host 5433)
POSTGRES_PASSWORD="change-me"
DATABASE_URL="postgresql://hireflow:change-me@localhost:5433/hireflow?schema=public"

# Auth.js session signing key: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET="change-me"
AUTH_URL="http://localhost:3000"

# OpenAI. Leave empty to run the app in deterministic mock mode.
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_CHAT_MODEL="gpt-4o-mini"
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"
